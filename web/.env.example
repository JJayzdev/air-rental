# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public catalog read credentials (catalog requests run on the server using anon/RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only opt-in. Requires configured Supabase Auth SMS provider. Defaults to disabled.
AIR_ENABLE_PHONE_OTP=false
# Server-only opt-in for optional identity-document collection. Also requires the service role key.
AIR_ENABLE_IDENTITY_DOCUMENTS=false

# Never expose this in the browser. Required only for protected identity-document storage.
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (tùy chọn)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

