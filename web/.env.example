# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public catalog read credentials (catalog requests run on the server using anon/RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only opt-in. Requires configured Supabase Auth SMS provider. Defaults to disabled.
AIR_ENABLE_PHONE_OTP=false
# Server-only opt-in for optional identity-document collection. Also requires the service role key.
AIR_ENABLE_IDENTITY_DOCUMENTS=false

# Never expose this in the browser. Used for protected document storage and the chat quota RPC.
SUPABASE_SERVICE_ROLE_KEY=

# Chat quota RPC only; all chat data reads use the cookie session and anon-key RLS client.
CHAT_RATE_LIMIT_SECRET=
CHAT_TRUST_PROXY=false
AIR_ENABLE_CHAT_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Payments (GĐ4). Off by default; the webhook returns 200 "disabled" until this is true.
AIR_ENABLE_PAYMENTS=false
# SePay sends `Authorization: Apikey <secret>`; must match this value exactly.
SEPAY_WEBHOOK_SECRET=
# Receiving account shown on the order page for bank transfer.
AIR_BANK_NAME=
AIR_BANK_ACCOUNT_NUMBER=
AIR_BANK_ACCOUNT_NAME=

# Sentry (tùy chọn)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Server-only optional operator alert. Keep disabled until an HTTPS endpoint is configured.
# The endpoint receives only sanitized application.exception events; its URL is secret config.
AIR_ENABLE_ERROR_ALERTS=false
OPS_ALERT_WEBHOOK_URL=

